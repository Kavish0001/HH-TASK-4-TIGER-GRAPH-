# TigerGraph (Community Edition in Docker)
TG_HOST=http://localhost
TG_RESTPP_PORT=14240
TG_GSQL_PORT=14240
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_GRAPH_NAME=FraudInvestigation

# LLM: provider is pluggable, set one key
# Gemini free tier key from https://aistudio.google.com/apikey (no card needed)
# Verified working: gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3-flash-preview.
# gemini-2.5-* return 404 (retired for new keys). 3.6/3.8-flash returned 503 under load.
# LLM_FALLBACK_MODELS is tried in order when the primary returns 503.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=

# Free-tier rate limits are the binding constraint across 20 cases.
# The client paces itself and retries on 429 rather than failing the run.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
LLM_MAX_RPM=10
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_S=2

# Alternatives, unused unless LLM_PROVIDER changes
OPENAI_API_KEY=

# Embeddings used for GraphRAG vectors
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AGENT_MAX_STEPS=24

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
