# Leave empty to run on the bundled mock cases in lib/mock/.
# Set to the FastAPI base URL (backend/api/main.py) to use the live backend, e.g.
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=

# Poll interval in ms when the SSE stream fails and the client falls back to polling.
NEXT_PUBLIC_POLL_MS=1500
